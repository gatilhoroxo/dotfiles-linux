#!/usr/bin/env bash

echo "Portable mDev CLI"

# rodando o arquivo com AS variáveis de ambiente
TEMP="$(realpath "${BASH_SOURCE[0]}")"
TEMP="$(dirname "$TEMP")"
TEMP="$(dirname "$TEMP")" #segunda linha igual proposital
source $TEMP/lib/core.sh #principais variaveis de ambiente

if [ $# -eq 0 ]; then
  echo "Help about the use of this tool."
else
  case "$1" in
    clean)
      echo "Command $1 not implemented yet."
      ;;
    doctor)
      echo "Running $1..."
      ;;
    enter)
      echo "Command $1 not implemented yet."
      ;;
    install)
      echo "Command $1 not implemented yet."
      ;;
    setup)
      echo "Running $1..."
      ;;
    update)
      echo "Command $1 not implemented yet."
      ;;
    *)
      echo "Unknown command: $1"
      ;;
    
  esac

fi
